---
import { useTranslations, type SupportedLocale } from '../i18n/ui';

interface Props {
  lang: SupportedLocale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
  class="first-fold-viewport mx-auto w-full max-w-5xl"
  aria-label={t('hero.title')}
>
  <!-- Main Interactive MP4-to-MP3 Converter Box Div -->
  <div
    id="converter-workspace-box"
    class="workspace-card w-full p-5 sm:p-8 md:p-10"
    data-msg-decoding={t('progress.decodingAudio')}
    data-msg-encoding={t('progress.encodingMp3')}
    data-msg-wasm={t('progress.wasmFallback')}
    data-msg-file-counter={t('progress.fileCounter')}
    data-msg-convert-single={t('controls.convertBtn')}
    data-msg-convert-batch={t('controls.convertBatchBtn')}
    data-msg-download={t('result.downloadBtn')}
    data-msg-preview-label={t('result.previewLabel')}
    data-msg-size={t('result.fileSize')}
    data-msg-duration={t('result.duration')}
    data-msg-bitrate={t('result.bitrateBadge')}
  >
    <!-- Compact Top Header Inside Box -->
    <div class="mb-6 text-center">
      <div
        class="mb-3 inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-xs font-extrabold uppercase tracking-wider shadow-xs sm:text-sm"
        style="background-color: rgba(49, 170, 169, 0.16); color: var(--text-primary); border: 1.5px solid #31AAA9;"
      >
        <span class="inline-block h-2.5 w-2.5 rounded-full" style="background-color: #31AAA9;" aria-hidden="true"></span>
        <span>{t('hero.badge')}</span>
      </div>

      <h1
        class="hero-heading mx-auto max-w-3xl"
        style="font-size: clamp(2rem, 4vw, 3.25rem);"
      >
        {t('hero.title')}
      </h1>

      <p
        class="mx-auto mt-2 max-w-2xl text-base font-medium sm:text-lg md:text-xl"
        style="color: var(--text-secondary);"
      >
        {t('hero.subtitle')}
      </p>
    </div>

    <!-- Hidden File Input supporting batch conversion -->
    <input
      type="file"
      id="video-file-input"
      accept=".mp4,.mov,.webm,.mkv,video/mp4,video/quicktime,video/webm,video/x-matroska,video/*,audio/*"
      multiple
      class="sr-only"
      aria-label={t('dropzone.browseBtn')}
    />

    <!-- ============================================================== -->
    <!-- STEP 1: GIANT DASHED DROPZONE BOX                              -->
    <!-- ============================================================== -->
    <div id="step-1-dropzone" class="step-panel">
      <div
        id="dropzone-box"
        role="button"
        tabindex="0"
        aria-label={t('dropzone.title')}
        class="dropzone-area flex flex-col items-center justify-center px-4 py-8 text-center sm:px-8 sm:py-11"
      >
        <!-- Oversized 64x64 Crisp SVG Icon -->
        <div
          class="animate-float-icon mb-5 flex h-20 w-20 items-center justify-center rounded-3xl border-2 shadow-md"
          style="background-color: #F8E0A4; border-color: #6C1A1A; color: #6C1A1A;"
          aria-hidden="true"
        >
          <svg
            class="h-12 w-12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" stroke="#6C1A1A" />
            <polyline points="17 8 12 3 7 8" stroke="#A82020" />
            <line x1="12" x2="12" y1="3" y2="15" stroke="#A82020" />
          </svg>
        </div>

        <h2 class="mb-2 text-2xl font-extrabold sm:text-3xl" style="color: var(--text-primary);">
          {t('dropzone.title')}
        </h2>

        <p class="mb-6 max-w-xl text-base font-medium sm:text-lg" style="color: var(--text-secondary);">
          {t('dropzone.subtitle')}
        </p>

        <!-- Action Buttons Inside Dropzone -->
        <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4">
          <button
            type="button"
            id="browse-files-btn"
            aria-label={t('dropzone.browseBtn')}
            class="btn-primary-action inline-flex items-center gap-3 px-8 py-4 text-lg font-extrabold shadow-lg sm:text-xl"
          >
            <svg
              class="h-6 w-6 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z" />
              <polyline points="14 2 14 8 20 8" />
              <path d="M12 18v-6" />
              <path d="m9 15 3-3 3 3" />
            </svg>
            <span>{t('dropzone.browseBtn')}</span>
          </button>

          <button
            type="button"
            id="demo-video-btn"
            aria-label={t('dropzone.sampleBtn')}
            class="inline-flex cursor-pointer items-center gap-2 rounded-full border-2 px-6 py-4 text-base font-extrabold transition-all duration-200 hover:scale-[1.02] sm:text-lg"
            style="background-color: var(--workspace-box-bg); border-color: #31AAA9; color: var(--text-primary);"
          >
            <svg
              class="h-5 w-5 shrink-0"
              style="color: #31AAA9;"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <polygon points="5 3 19 12 5 21 5 3" />
            </svg>
            <span>{t('dropzone.sampleBtn')}</span>
          </button>
        </div>

        <!-- Supported Formats Pill -->
        <div
          class="mt-6 inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-xs font-bold sm:text-sm"
          style="background-color: var(--surface-subtle); color: var(--text-primary);"
        >
          <span>{t('dropzone.formats')}</span>
        </div>
      </div>

      <!-- Privacy Footer Note + Workspace Offline PWA Install Pill -->
      <div class="mt-3.5 flex flex-wrap items-center justify-between gap-2 px-1">
        <p
          class="flex items-center gap-2 text-xs font-bold sm:text-sm"
          style="color: var(--text-primary);"
        >
          <svg
            class="h-4 w-4 shrink-0"
            style="color: #31AAA9;"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            aria-hidden="true"
          >
            <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
          </svg>
          <span>{t('dropzone.privacyNote')}</span>
        </p>

        <button
          type="button"
          id="workspace-install-pwa-btn"
          data-install-pwa-trigger
          aria-label={t('nav.installAppAria')}
          class="inline-flex cursor-pointer items-center gap-1.5 rounded-full border-2 px-3.5 py-1 text-xs font-extrabold transition-transform hover:scale-105"
          style="background-color: #F8E0A4; border-color: #6C1A1A; color: #6C1A1A;"
        >
          <svg
            class="h-3.5 w-3.5 shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#A82020"
            stroke-width="2.5"
            aria-hidden="true"
          >
            <path d="M12 3v12" />
            <path d="m7 10 5 5 5-5" />
            <path d="M5 21h14" />
          </svg>
          <span>{t('pwa.workspaceInstallBtn')}</span>
        </button>
      </div>
    </div>

    <!-- ============================================================== -->
    <!-- STEP 2: INSTANT BITRATE & TRIM CONTROLS                        -->
    <!-- ============================================================== -->
    <div id="step-2-controls" class="step-panel hidden space-y-6">
      <!-- Selected Files List Header -->
      <div
        class="rounded-2xl border-2 p-4 sm:p-5"
        style="background-color: var(--surface-subtle); border-color: var(--border-color);"
      >
        <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
          <h2 class="text-lg font-extrabold sm:text-xl" style="color: var(--text-primary);">
            {t('controls.selectedFiles')} (<span id="selected-files-count">0</span>)
          </h2>
          <div class="flex items-center gap-2">
            <button
              type="button"
              id="add-more-files-btn"
              aria-label={t('controls.addMoreFiles')}
              class="cursor-pointer rounded-full border-2 px-3.5 py-1.5 text-xs font-extrabold transition-transform hover:scale-105 sm:text-sm"
              style="border-color: #31AAA9; background-color: var(--workspace-box-bg); color: var(--text-primary);"
            >
              {t('controls.addMoreFiles')}
            </button>
            <button
              type="button"
              id="clear-files-btn"
              aria-label={t('controls.clearAll')}
              class="cursor-pointer rounded-full border-2 px-3.5 py-1.5 text-xs font-extrabold transition-transform hover:scale-105 sm:text-sm"
              style="border-color: #A82020; color: var(--text-secondary);"
            >
              {t('controls.clearAll')}
            </button>
          </div>
        </div>

        <ul id="selected-files-list" class="max-h-40 space-y-2 overflow-y-auto pr-1"></ul>
      </div>

      <!-- Bitrate Quality Big Pill Selectors -->
      <div>
        <span
          id="bitrate-group-label"
          class="mb-3 block text-lg font-extrabold sm:text-xl"
          style="color: var(--text-primary);"
        >
          {t('controls.qualityLabel')}
        </span>
        <div
          class="grid grid-cols-1 gap-3.5 md:grid-cols-3"
          role="radiogroup"
          aria-labelledby="bitrate-group-label"
        >
          {
            [
              {
                rate: '128',
                fullLabel: t('controls.bitrate128'),
                desc: t('controls.bitrate128Desc'),
                isDefault: false,
              },
              {
                rate: '192',
                fullLabel: t('controls.bitrate192'),
                desc: t('controls.bitrate192Desc'),
                isDefault: false,
              },
              {
                rate: '320',
                fullLabel: t('controls.bitrate320'),
                desc: t('controls.bitrate320Desc'),
                isDefault: true,
              },
            ].map((item) => {
              const parenIdx = item.fullLabel.indexOf('(');
              const mainSpeed =
                parenIdx !== -1 ? item.fullLabel.slice(0, parenIdx).trim() : item.fullLabel;
              const tierLabel =
                parenIdx !== -1
                  ? item.fullLabel.slice(parenIdx + 1).replace(/\)$/, '').trim()
                  : '';

              return (
                <button
                  type="button"
                  role="radio"
                  aria-checked={item.isDefault ? 'true' : 'false'}
                  aria-label={item.fullLabel}
                  data-bitrate={item.rate}
                  class:list={[
                    'bitrate-pill flex h-full w-full flex-col justify-between gap-2 p-4 text-left lg:p-5',
                    item.isDefault && 'active',
                  ]}
                >
                  <div class="flex w-full flex-wrap items-center justify-between gap-2">
                    <span class="text-lg font-black tracking-tight lg:text-xl">
                      {mainSpeed}
                    </span>
                    {tierLabel && (
                      <span class="tier-badge rounded-full px-2.5 py-0.5 text-xs font-extrabold">
                        {tierLabel}
                      </span>
                    )}
                  </div>
                  <span class="text-xs font-semibold leading-snug opacity-95 sm:text-sm">
                    {item.desc}
                  </span>
                </button>
              );
            })
          }
        </div>
      </div>

      <!-- Audio Trim & Fade Controls -->
      <div
        class="rounded-2xl border-2 p-4 sm:p-5"
        style="border-color: var(--border-color); background-color: var(--workspace-box-bg);"
      >
        <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
          <span class="flex items-center gap-2 text-base font-extrabold sm:text-lg" style="color: var(--text-primary);">
            <svg
              class="h-5 w-5"
              style="color: #31AAA9;"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.3"
              aria-hidden="true"
            >
              <circle cx="6" cy="6" r="3" />
              <circle cx="6" cy="18" r="3" />
              <line x1="20" x2="8.12" y1="4" y2="15.88" />
              <line x1="14.47" x2="20" y1="14.48" y2="20" />
              <line x1="8.12" x2="12" y1="8.12" y2="12" />
            </svg>
            {t('controls.trimToggle')}
          </span>
          <span class="text-xs font-bold" style="color: var(--text-secondary);">
            {t('controls.trimFullHint')}
          </span>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <!-- Trim Start -->
          <div>
            <div class="mb-1 flex items-center justify-between text-sm font-bold">
              <label for="trim-start-input">{t('controls.trimStart')}</label>
              <span id="trim-start-val" style="color: var(--accent-text-readable);">0s</span>
            </div>
            <div class="flex items-center gap-3">
              <input
                type="range"
                id="trim-start-slider"
                min="0"
                max="600"
                step="1"
                value="0"
                class="trim-slider w-full"
                aria-label={t('controls.trimStart')}
              />
              <input
                type="number"
                id="trim-start-input"
                min="0"
                max="36000"
                step="1"
                value="0"
                aria-label={t('controls.trimStart')}
                class="w-20 rounded-xl border-2 px-2.5 py-1.5 text-center text-sm font-bold"
                style="border-color: var(--border-color); background-color: var(--bg-primary); color: var(--text-primary);"
              />
            </div>
          </div>

          <!-- Trim End -->
          <div>
            <div class="mb-1 flex items-center justify-between text-sm font-bold">
              <label for="trim-end-input">{t('controls.trimEnd')}</label>
              <span id="trim-end-val" style="color: var(--accent-text-readable);">0s (Full)</span>
            </div>
            <div class="flex items-center gap-3">
              <input
                type="range"
                id="trim-end-slider"
                min="0"
                max="600"
                step="1"
                value="0"
                class="trim-slider w-full"
                aria-label={t('controls.trimEnd')}
              />
              <input
                type="number"
                id="trim-end-input"
                min="0"
                max="36000"
                step="1"
                value="0"
                aria-label={t('controls.trimEnd')}
                class="w-20 rounded-xl border-2 px-2.5 py-1.5 text-center text-sm font-bold"
                style="border-color: var(--border-color); background-color: var(--bg-primary); color: var(--text-primary);"
              />
            </div>
          </div>
        </div>

        <!-- Fade In / Fade Out Toggles -->
        <div class="mt-4 flex flex-wrap items-center gap-4 pt-2">
          <label
            for="fade-in-toggle"
            class="inline-flex cursor-pointer items-center gap-2.5 rounded-xl border-2 px-4 py-2 text-sm font-extrabold transition-colors"
            style="border-color: var(--border-color);"
          >
            <input
              type="checkbox"
              id="fade-in-toggle"
              aria-label={t('controls.fadeIn')}
              class="h-4 w-4 accent-[#31AAA9]"
            />
            <span>{t('controls.fadeIn')}</span>
          </label>

          <label
            for="fade-out-toggle"
            class="inline-flex cursor-pointer items-center gap-2.5 rounded-xl border-2 px-4 py-2 text-sm font-extrabold transition-colors"
            style="border-color: var(--border-color);"
          >
            <input
              type="checkbox"
              id="fade-out-toggle"
              aria-label={t('controls.fadeOut')}
              class="h-4 w-4 accent-[#31AAA9]"
            />
            <span>{t('controls.fadeOut')}</span>
          </label>
        </div>
      </div>

      <!-- Massive Convert CTA Button -->
      <div class="flex justify-center pt-1">
        <button
          type="button"
          id="start-convert-btn"
          aria-label={t('controls.convertBtn')}
          class="btn-primary-action flex w-full items-center justify-center gap-3 py-5 text-xl font-extrabold shadow-xl sm:w-auto sm:min-w-[340px] sm:px-12 sm:text-2xl"
        >
          <svg
            class="h-7 w-7 shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M9 18V5l12-2v13" />
            <circle cx="6" cy="18" r="3" />
            <circle cx="18" cy="16" r="3" />
          </svg>
          <span id="start-convert-btn-text">{t('controls.convertBtn')}</span>
        </button>
      </div>
    </div>

    <!-- ============================================================== -->
    <!-- STEP 3: ANIMATED EXTRACTION PROGRESS (SOUNDWAVE / EQUALIZER)   -->
    <!-- ============================================================== -->
    <div
      id="step-3-progress"
      role="status"
      aria-live="polite"
      class="step-panel hidden py-8 text-center"
    >
      <h2 class="mb-2 text-2xl font-extrabold sm:text-3xl" style="color: var(--text-primary);">
        {t('progress.extractingTitle')}
      </h2>
      <p
        id="progress-stage-label"
        aria-live="polite"
        class="mb-6 text-base font-bold sm:text-lg"
        style="color: var(--text-secondary);"
      >
        {t('progress.decodingAudio')}
      </p>

      <!-- Animated Soundwave Equalizer (#31AAA9 and #A82020) -->
      <div
        class="mx-auto mb-6 flex h-24 max-w-md items-end justify-center gap-2 px-4"
        aria-hidden="true"
      >
        {
          Array.from({ length: 20 }).map((_, idx) => {
            const delay = ((idx % 7) * 0.12).toFixed(2);
            const heightRem = 2.5 + ((idx * 3) % 4) * 0.75;
            return (
              <div
                class="eq-bar"
                style={`height: ${heightRem}rem; animation-delay: ${delay}s;`}
              />
            );
          })
        }
      </div>

      <!-- Real-Time Percentage Counter (0% to 100%) -->
      <div
        id="progress-percentage-counter"
        class="mb-4 text-5xl font-black tracking-tight sm:text-6xl"
        style="color: var(--text-primary);"
        aria-live="polite"
      >
        0%
      </div>

      <!-- Progress Bar -->
      <div
        class="mx-auto mb-3 h-4 w-full max-w-lg overflow-hidden rounded-full border-2"
        style="background-color: var(--surface-subtle); border-color: var(--border-color);"
        role="progressbar"
        id="progress-bar-container"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
        aria-label={t('progress.extractingTitle')}
      >
        <div
          id="progress-bar-fill"
          class="h-full transition-all duration-150 ease-out"
          style="width: 0%; background: linear-gradient(90deg, #31AAA9 0%, #A82020 100%);"
        >
        </div>
      </div>

      <p
        id="progress-file-counter"
        class="mb-6 text-sm font-extrabold"
        style="color: var(--accent-text-readable);"
      ></p>

      <button
        type="button"
        id="cancel-convert-btn"
        aria-label={t('progress.cancelBtn')}
        class="cursor-pointer rounded-full border-2 px-6 py-2.5 text-sm font-extrabold transition-transform hover:scale-105"
        style="border-color: #A82020; color: var(--text-secondary);"
      >
        {t('progress.cancelBtn')}
      </button>
    </div>

    <!-- ============================================================== -->
    <!-- STEP 4: INSTANT DOWNLOAD & HTML5 AUDIO PREVIEW                 -->
    <!-- ============================================================== -->
    <div id="step-4-result" aria-live="polite" class="step-panel hidden space-y-6 py-2">
      <div class="text-center">
        <div
          class="mx-auto mb-3 flex h-16 w-16 items-center justify-center rounded-full border-3 shadow-md"
          style="background-color: #F8E0A4; border-color: #31AAA9; color: #6C1A1A;"
          aria-hidden="true"
        >
          <svg
            class="h-9 w-9"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#6C1A1A"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="20 6 9 17 4 12" />
          </svg>
        </div>
        <h2 class="text-2xl font-extrabold sm:text-3xl" style="color: var(--text-primary);">
          {t('result.successTitle')}
        </h2>
        <p class="mt-1 text-base font-medium sm:text-lg" style="color: var(--text-secondary);">
          {t('result.successSubtitle')}
        </p>
      </div>

      <!-- Converted Audio Items List (Supports Single & Batch Results) -->
      <div id="converted-results-list" class="space-y-4"></div>

      <!-- Primary Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
        <a
          id="primary-download-link"
          href="#"
          download="audio.mp3"
          aria-label={t('result.downloadBtn')}
          class="btn-primary-action inline-flex items-center justify-center gap-3 px-10 py-4 text-xl font-extrabold shadow-xl"
        >
          <svg
            class="h-7 w-7 shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" x2="12" y1="15" y2="3" />
          </svg>
          <span>{t('result.downloadBtn')}</span>
        </a>

        <button
          type="button"
          id="convert-another-btn"
          aria-label={t('result.convertAnotherBtn')}
          class="inline-flex cursor-pointer items-center justify-center gap-2 rounded-full border-3 px-8 py-4 text-lg font-extrabold transition-all duration-200 hover:scale-[1.02]"
          style="border-color: #31AAA9; background-color: var(--workspace-box-bg); color: var(--text-primary);"
        >
          <svg
            class="h-6 w-6 shrink-0"
            style="color: #31AAA9;"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
            <path d="M3 3v5h5" />
          </svg>
          <span>{t('result.convertAnotherBtn')}</span>
        </button>
      </div>
    </div>

    <!-- Error State Panel -->
    <div id="step-error-panel" role="alert" class="step-panel hidden py-8 text-center">
      <div
        class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full border-2"
        style="background-color: rgba(168, 32, 32, 0.12); border-color: #A82020; color: #A82020;"
        aria-hidden="true"
      >
        <svg class="h-9 w-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <circle cx="12" cy="12" r="10" />
          <line x1="12" x2="12" y1="8" y2="12" />
          <line x1="12" x2="12.01" y1="16" y2="16" />
        </svg>
      </div>
      <h2 class="mb-2 text-2xl font-extrabold" style="color: var(--text-primary);">
        {t('result.errorTitle')}
      </h2>
      <p id="error-detail-message" class="mx-auto mb-6 max-w-lg text-base font-medium" style="color: var(--text-secondary);">
        {t('result.errorDesc')}
      </p>
      <button
        type="button"
        id="error-retry-btn"
        aria-label={t('result.tryAgainBtn')}
        class="btn-primary-action px-8 py-3.5 text-lg font-extrabold"
      >
        {t('result.tryAgainBtn')}
      </button>
    </div>
  </div>
</section>

<script>
  import {
    convertVideoToMp3,
    createDemoVideoFile,
    formatBytes,
    formatDuration,
    type BitrateOption,
    type ConvertedMp3Result,
  } from '../utils/audioEngine';

  function initConverterWorkspace() {
    const workspaceBox = document.getElementById('converter-workspace-box');
    if (!workspaceBox) return;

    const msgDecoding = workspaceBox.getAttribute('data-msg-decoding') || 'Decoding audio...';
    const msgEncoding = workspaceBox.getAttribute('data-msg-encoding') || 'Encoding MP3...';
    const msgWasm = workspaceBox.getAttribute('data-msg-wasm') || 'Running WebAssembly FFmpeg...';
    const msgFileCounter = workspaceBox.getAttribute('data-msg-file-counter') || 'Processing file';
    const msgConvertSingle = workspaceBox.getAttribute('data-msg-convert-single') || 'Convert to MP3 Now';
    const msgConvertBatch = workspaceBox.getAttribute('data-msg-convert-batch') || 'Convert All to MP3';
    const msgDownload = workspaceBox.getAttribute('data-msg-download') || 'Download MP3';
    const msgPreviewLabel = workspaceBox.getAttribute('data-msg-preview-label') || 'Audio Preview Player';
    const msgSize = workspaceBox.getAttribute('data-msg-size') || 'Size';
    const msgDuration = workspaceBox.getAttribute('data-msg-duration') || 'Duration';
    const msgBitrate = workspaceBox.getAttribute('data-msg-bitrate') || 'Bitrate';

    // Step Panels
    const step1 = document.getElementById('step-1-dropzone');
    const step2 = document.getElementById('step-2-controls');
    const step3 = document.getElementById('step-3-progress');
    const step4 = document.getElementById('step-4-result');
    const stepError = document.getElementById('step-error-panel');

    // Interactive Elements
    const fileInput = document.getElementById('video-file-input') as HTMLInputElement | null;
    const dropzoneBox = document.getElementById('dropzone-box');
    const browseBtn = document.getElementById('browse-files-btn');
    const demoBtn = document.getElementById('demo-video-btn');
    const addMoreBtn = document.getElementById('add-more-files-btn');
    const clearFilesBtn = document.getElementById('clear-files-btn');
    const selectedFilesCount = document.getElementById('selected-files-count');
    const selectedFilesList = document.getElementById('selected-files-list');
    const bitrateButtons = document.querySelectorAll<HTMLButtonElement>('[data-bitrate]');

    // Trim & Fade Controls
    const trimStartSlider = document.getElementById('trim-start-slider') as HTMLInputElement | null;
    const trimStartInput = document.getElementById('trim-start-input') as HTMLInputElement | null;
    const trimStartVal = document.getElementById('trim-start-val');
    const trimEndSlider = document.getElementById('trim-end-slider') as HTMLInputElement | null;
    const trimEndInput = document.getElementById('trim-end-input') as HTMLInputElement | null;
    const trimEndVal = document.getElementById('trim-end-val');
    const fadeInToggle = document.getElementById('fade-in-toggle') as HTMLInputElement | null;
    const fadeOutToggle = document.getElementById('fade-out-toggle') as HTMLInputElement | null;

    // Conversion & Progress Elements
    const startConvertBtn = document.getElementById('start-convert-btn');
    const startConvertBtnText = document.getElementById('start-convert-btn-text');
    const progressStageLabel = document.getElementById('progress-stage-label');
    const progressCounter = document.getElementById('progress-percentage-counter');
    const progressBarFill = document.getElementById('progress-bar-fill');
    const progressBarContainer = document.getElementById('progress-bar-container');
    const progressFileCounter = document.getElementById('progress-file-counter');
    const cancelConvertBtn = document.getElementById('cancel-convert-btn');

    // Results Elements
    const convertedResultsList = document.getElementById('converted-results-list');
    const primaryDownloadLink = document.getElementById('primary-download-link') as HTMLAnchorElement | null;
    const convertAnotherBtn = document.getElementById('convert-another-btn');
    const errorRetryBtn = document.getElementById('error-retry-btn');

    // State
    let selectedFiles: File[] = [];
    let selectedBitrate: BitrateOption = 320;
    let activeAbortController: AbortController | null = null;
    let generatedResults: ConvertedMp3Result[] = [];

    const showStep = (stepNumber: 1 | 2 | 3 | 4 | 'error') => {
      step1?.classList.toggle('hidden', stepNumber !== 1);
      step2?.classList.toggle('hidden', stepNumber !== 2);
      step3?.classList.toggle('hidden', stepNumber !== 3);
      step4?.classList.toggle('hidden', stepNumber !== 4);
      stepError?.classList.toggle('hidden', stepNumber !== 'error');
    };

    const cleanupUrls = () => {
      for (const r of generatedResults) {
        try {
          URL.revokeObjectURL(r.url);
        } catch {}
      }
      generatedResults = [];
    };

    const renderSelectedFiles = () => {
      if (!selectedFilesList || !selectedFilesCount) return;
      selectedFilesCount.textContent = String(selectedFiles.length);
      selectedFilesList.innerHTML = '';

      selectedFiles.forEach((file, idx) => {
        const li = document.createElement('li');
        li.className =
          'flex items-center justify-between gap-3 rounded-xl border px-3.5 py-2.5 text-sm font-bold';
        li.style.backgroundColor = 'var(--workspace-box-bg)';
        li.style.borderColor = 'var(--border-color)';

        const infoDiv = document.createElement('div');
        infoDiv.className = 'flex items-center gap-2.5 truncate';

        const badge = document.createElement('span');
        badge.className = 'rounded-lg px-2 py-0.5 text-xs font-extrabold uppercase';
        badge.style.backgroundColor = '#F8E0A4';
        badge.style.color = '#6C1A1A';
        const ext = file.name.split('.').pop()?.toUpperCase() || 'MP4';
        badge.textContent = ext;

        const nameSpan = document.createElement('span');
        nameSpan.className = 'truncate';
        nameSpan.textContent = file.name;

        const sizeSpan = document.createElement('span');
        sizeSpan.className = 'shrink-0 text-xs opacity-85';
        sizeSpan.textContent = `(${formatBytes(file.size)})`;

        infoDiv.appendChild(badge);
        infoDiv.appendChild(nameSpan);
        infoDiv.appendChild(sizeSpan);

        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className =
          'flex h-7 w-7 shrink-0 cursor-pointer items-center justify-center rounded-full text-xs font-extrabold transition-colors';
        removeBtn.style.backgroundColor = 'rgba(168, 32, 32, 0.16)';
        removeBtn.style.color = 'var(--text-secondary)';
        removeBtn.textContent = '✕';
        removeBtn.setAttribute('aria-label', `Remove ${file.name}`);
        removeBtn.addEventListener('click', () => {
          selectedFiles.splice(idx, 1);
          if (selectedFiles.length === 0) {
            showStep(1);
          } else {
            renderSelectedFiles();
          }
        });

        li.appendChild(infoDiv);
        li.appendChild(removeBtn);
        selectedFilesList.appendChild(li);
      });

      if (startConvertBtnText) {
        startConvertBtnText.textContent =
          selectedFiles.length > 1 ? `${msgConvertBatch} (${selectedFiles.length})` : msgConvertSingle;
      }
    };

    const handleIncomingFiles = (fileList: FileList | File[]) => {
      const incoming = Array.from(fileList);
      if (incoming.length === 0) return;
      selectedFiles = [...selectedFiles, ...incoming];
      renderSelectedFiles();
      showStep(2);
    };

    browseBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      fileInput?.click();
    });

    demoBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const demoFile = createDemoVideoFile();
      selectedFiles = [demoFile];
      renderSelectedFiles();
      showStep(2);
    });

    dropzoneBox?.addEventListener('click', () => {
      fileInput?.click();
    });

    dropzoneBox?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        fileInput?.click();
      }
    });

    fileInput?.addEventListener('change', () => {
      if (fileInput.files && fileInput.files.length > 0) {
        handleIncomingFiles(fileInput.files);
        fileInput.value = '';
      }
    });

    ['dragenter', 'dragover'].forEach((eventName) => {
      dropzoneBox?.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzoneBox.classList.add('drag-over');
      });
    });

    ['dragleave', 'drop'].forEach((eventName) => {
      dropzoneBox?.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzoneBox.classList.remove('drag-over');
      });
    });

    dropzoneBox?.addEventListener('drop', (e: DragEvent) => {
      if (e.dataTransfer?.files && e.dataTransfer.files.length > 0) {
        handleIncomingFiles(e.dataTransfer.files);
      }
    });

    addMoreBtn?.addEventListener('click', () => fileInput?.click());
    clearFilesBtn?.addEventListener('click', () => {
      selectedFiles = [];
      showStep(1);
    });

    // Bitrate Pill Selector with ARIA radio states
    bitrateButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const rate = Number(btn.getAttribute('data-bitrate')) as BitrateOption;
        selectedBitrate = rate;
        bitrateButtons.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-checked', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-checked', 'true');
      });
    });

    // Trim Sliders & Number Input Sync
    const syncTrimStart = (val: string) => {
      const n = Math.max(0, Number(val) || 0);
      if (trimStartSlider) trimStartSlider.value = String(Math.min(600, n));
      if (trimStartInput) trimStartInput.value = String(n);
      if (trimStartVal) trimStartVal.textContent = `${n}s`;
    };

    const syncTrimEnd = (val: string) => {
      const n = Math.max(0, Number(val) || 0);
      if (trimEndSlider) trimEndSlider.value = String(Math.min(600, n));
      if (trimEndInput) trimEndInput.value = String(n);
      if (trimEndVal) trimEndVal.textContent = n === 0 ? '0s (Full)' : `${n}s`;
    };

    trimStartSlider?.addEventListener('input', () => syncTrimStart(trimStartSlider.value));
    trimStartInput?.addEventListener('input', () => syncTrimStart(trimStartInput.value));
    trimEndSlider?.addEventListener('input', () => syncTrimEnd(trimEndSlider.value));
    trimEndInput?.addEventListener('input', () => syncTrimEnd(trimEndInput.value));

    const updateProgressUI = (pct: number, stage: 'decoding' | 'encoding' | 'wasm') => {
      const clamped = Math.max(0, Math.min(100, Math.round(pct)));
      if (progressCounter) progressCounter.textContent = `${clamped}%`;
      if (progressBarFill) progressBarFill.style.width = `${clamped}%`;
      if (progressBarContainer) progressBarContainer.setAttribute('aria-valuenow', String(clamped));
      if (progressStageLabel) {
        if (stage === 'decoding') progressStageLabel.textContent = msgDecoding;
        else if (stage === 'wasm') progressStageLabel.textContent = msgWasm;
        else progressStageLabel.textContent = msgEncoding;
      }
    };

    const renderResults = () => {
      if (!convertedResultsList) return;
      convertedResultsList.innerHTML = '';

      generatedResults.forEach((res) => {
        const card = document.createElement('div');
        card.className = 'rounded-2xl border-2 p-4 sm:p-5 space-y-3';
        card.style.backgroundColor = 'var(--surface-subtle)';
        card.style.borderColor = 'var(--border-color)';

        const topRow = document.createElement('div');
        topRow.className = 'flex flex-wrap items-center justify-between gap-2';

        const titleEl = document.createElement('h3');
        titleEl.className = 'text-base sm:text-lg font-extrabold truncate';
        titleEl.textContent = res.outputName;

        const badgesDiv = document.createElement('div');
        badgesDiv.className = 'flex flex-wrap items-center gap-2 text-xs font-extrabold';

        const makeBadge = (text: string, bg: string, color: string) => {
          const b = document.createElement('span');
          b.className = 'rounded-full px-3 py-1';
          b.style.backgroundColor = bg;
          b.style.color = color;
          b.textContent = text;
          return b;
        };

        badgesDiv.appendChild(
          makeBadge(`${msgBitrate}: ${res.bitrate} kbps`, '#31AAA9', '#1A0909')
        );
        badgesDiv.appendChild(
          makeBadge(`${msgDuration}: ${formatDuration(res.durationSeconds)}`, '#F8E0A4', '#6C1A1A')
        );
        badgesDiv.appendChild(
          makeBadge(`${msgSize}: ${formatBytes(res.sizeBytes)}`, '#6C1A1A', '#F8E0A4')
        );

        topRow.appendChild(titleEl);
        topRow.appendChild(badgesDiv);

        // Built-in HTML5 Audio Preview Player with ARIA label
        const audioPlayer = document.createElement('audio');
        audioPlayer.controls = true;
        audioPlayer.preload = 'metadata';
        audioPlayer.src = res.url;
        audioPlayer.setAttribute('aria-label', `${msgPreviewLabel}: ${res.outputName}`);
        audioPlayer.className = 'w-full rounded-xl';

        card.appendChild(topRow);
        card.appendChild(audioPlayer);

        if (generatedResults.length > 1) {
          const itemDownloadLink = document.createElement('a');
          itemDownloadLink.href = res.url;
          itemDownloadLink.download = res.outputName;
          itemDownloadLink.setAttribute('aria-label', `${msgDownload} ${res.outputName}`);
          itemDownloadLink.className =
            'btn-primary-action inline-flex items-center gap-2 px-5 py-2 text-sm font-extrabold';
          itemDownloadLink.textContent = `${msgDownload} (${res.outputName})`;
          card.appendChild(itemDownloadLink);
        }

        convertedResultsList.appendChild(card);
      });

      if (primaryDownloadLink && generatedResults.length > 0) {
        const first = generatedResults[0];
        primaryDownloadLink.href = first.url;
        primaryDownloadLink.download = first.outputName;
      }
    };

    startConvertBtn?.addEventListener('click', async () => {
      if (selectedFiles.length === 0) return;

      cleanupUrls();
      activeAbortController = new AbortController();
      updateProgressUI(0, 'decoding');
      showStep(3);

      const trimStart = Math.max(0, Number(trimStartInput?.value) || 0);
      const trimEnd = Math.max(0, Number(trimEndInput?.value) || 0);
      const fadeIn = Boolean(fadeInToggle?.checked);
      const fadeOut = Boolean(fadeOutToggle?.checked);

      try {
        const total = selectedFiles.length;
        for (let i = 0; i < total; i++) {
          const file = selectedFiles[i];
          if (progressFileCounter) {
            progressFileCounter.textContent = `${msgFileCounter} ${i + 1} / ${total}: ${file.name}`;
          }

          const result = await convertVideoToMp3(file, {
            bitrate: selectedBitrate,
            trimStart,
            trimEnd,
            fadeIn,
            fadeOut,
            signal: activeAbortController.signal,
            onProgress: (filePct, stage) => {
              const overallPct = ((i + filePct / 100) / total) * 100;
              updateProgressUI(overallPct, stage);
            },
          });

          generatedResults.push(result);
        }

        renderResults();
        showStep(4);
      } catch (err: any) {
        if (err?.name === 'AbortError') {
          showStep(2);
          return;
        }
        console.error('Audio extraction failed:', err);
        showStep('error');
      } finally {
        activeAbortController = null;
      }
    });

    cancelConvertBtn?.addEventListener('click', () => {
      activeAbortController?.abort();
    });

    convertAnotherBtn?.addEventListener('click', () => {
      cleanupUrls();
      selectedFiles = [];
      showStep(1);
    });

    errorRetryBtn?.addEventListener('click', () => {
      cleanupUrls();
      selectedFiles = [];
      showStep(1);
    });
  }

  initConverterWorkspace();
</script>
