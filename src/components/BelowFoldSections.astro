---
import { useTranslations, getLocalizedPath, type SupportedLocale } from '../i18n/ui';

interface Props {
  lang: SupportedLocale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const steps = [
  { title: t('howto.step1Title'), desc: t('howto.step1Desc'), badge: '01' },
  { title: t('howto.step2Title'), desc: t('howto.step2Desc'), badge: '02' },
  { title: t('howto.step3Title'), desc: t('howto.step3Desc'), badge: '03' },
];

const comparisons = [
  {
    title: t('compare.card1Title'),
    cloud: t('compare.card1Cloud'),
    local: t('compare.card1Local'),
  },
  {
    title: t('compare.card2Title'),
    cloud: t('compare.card2Cloud'),
    local: t('compare.card2Local'),
  },
  {
    title: t('compare.card3Title'),
    cloud: t('compare.card3Cloud'),
    local: t('compare.card3Local'),
  },
  {
    title: t('compare.card4Title'),
    cloud: t('compare.card4Cloud'),
    local: t('compare.card4Local'),
  },
];

const faqs = [
  { q: t('faq.q1'), a: t('faq.a1') },
  { q: t('faq.q2'), a: t('faq.a2') },
  { q: t('faq.q3'), a: t('faq.a3') },
  { q: t('faq.q4'), a: t('faq.a4') },
  { q: t('faq.q5'), a: t('faq.a5') },
  { q: t('faq.q6'), a: t('faq.a6') },
  { q: t('faq.q7'), a: t('faq.a7') },
];
---

<div class="mx-auto max-w-6xl space-y-20 px-4 py-12 sm:px-6 lg:px-8">
  <!-- Semantic Breadcrumb Navigation right below the first-fold Hero workspace -->
  <nav aria-label="Breadcrumb" class="rounded-2xl border-2 px-4 py-2.5 inline-block" style="background-color: var(--workspace-box-bg); border-color: var(--border-color);">
    <ol class="flex flex-wrap items-center gap-2 text-sm font-extrabold">
      <li>
        <a
          href={getLocalizedPath(lang)}
          class="underline decoration-2 underline-offset-4 transition-opacity hover:opacity-80"
          style="color: var(--accent-text-readable);"
        >
          {t('breadcrumb.home')}
        </a>
      </li>
      <li aria-hidden="true" style="color: var(--text-secondary);">/</li>
      <li aria-current="page" style="color: var(--text-primary);">
        {t('breadcrumb.converter')}
      </li>
    </ol>
  </nav>

  <!-- =================================================================== -->
  <!-- SECTION 1: 3-STEP VISUAL GUIDE                                      -->
  <!-- =================================================================== -->
  <section aria-labelledby="howto-heading" class="space-y-10">
    <div class="text-center">
      <span
        class="mb-3 inline-block rounded-full px-4 py-1.5 text-xs font-extrabold uppercase tracking-wider"
        style="background-color: #F8E0A4; color: #6C1A1A; border: 1.5px solid #6C1A1A;"
      >
        {t('howto.sectionBadge')}
      </span>
      <h2 id="howto-heading" class="section-heading mx-auto max-w-3xl">
        {t('howto.title')}
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-lg font-medium" style="color: var(--text-secondary);">
        {t('howto.subtitle')}
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        steps.map((step, idx) => (
          <article
            class="flex flex-col justify-between rounded-3xl border-2 p-7 shadow-sm transition-transform duration-200 hover:-translate-y-1"
            style="background-color: var(--workspace-box-bg); border-color: var(--border-color);"
          >
            <div>
              <div class="mb-5 flex items-center justify-between">
                <span
                  class="inline-flex h-12 w-12 items-center justify-center rounded-2xl text-lg font-black"
                  style="background-color: #31AAA9; color: #1A0909;"
                >
                  {step.badge}
                </span>
                {idx === 0 && (
                  <svg class="h-8 w-8" style="color: #A82020;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                    <polyline points="17 8 12 3 7 8" />
                    <line x1="12" x2="12" y1="3" y2="15" />
                  </svg>
                )}
                {idx === 1 && (
                  <svg class="h-8 w-8" style="color: #31AAA9;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                    <line x1="4" x2="4" y1="21" y2="14" />
                    <line x1="4" x2="4" y1="10" y2="3" />
                    <line x1="12" x2="12" y1="21" y2="12" />
                    <line x1="12" x2="12" y1="8" y2="3" />
                    <line x1="20" x2="20" y1="21" y2="16" />
                    <line x1="20" x2="20" y1="12" y2="3" />
                    <line x1="2" x2="6" y1="14" y2="14" />
                    <line x1="10" x2="14" y1="8" y2="8" />
                    <line x1="18" x2="22" y1="16" y2="16" />
                  </svg>
                )}
                {idx === 2 && (
                  <svg class="h-8 w-8" style="color: #A82020;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                    <path d="M9 18V5l12-2v13" />
                    <circle cx="6" cy="18" r="3" />
                    <circle cx="18" cy="16" r="3" />
                  </svg>
                )}
              </div>
              <h3 class="mb-2.5 text-xl font-extrabold" style="color: var(--text-primary);">
                {step.title}
              </h3>
              <p class="text-base font-medium leading-relaxed" style="color: var(--text-secondary);">
                {step.desc}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- =================================================================== -->
  <!-- SECTION 2: WHY 100% CLIENT-SIDE OFFLINE BEATS CLOUD CONVERTERS      -->
  <!-- =================================================================== -->
  <section aria-labelledby="compare-heading" class="space-y-10">
    <div class="text-center">
      <span
        class="mb-3 inline-block rounded-full px-4 py-1.5 text-xs font-extrabold uppercase tracking-wider"
        style="background-color: #31AAA9; color: #1A0909;"
      >
        {t('compare.sectionBadge')}
      </span>
      <h2 id="compare-heading" class="section-heading mx-auto max-w-4xl">
        {t('compare.title')}
      </h2>
      <p class="mx-auto mt-3 max-w-3xl text-lg font-medium" style="color: var(--text-secondary);">
        {t('compare.subtitle')}
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      {
        comparisons.map((card) => (
          <article
            class="flex flex-col justify-between space-y-4 rounded-3xl border-2 p-7 shadow-sm"
            style="background-color: var(--workspace-box-bg); border-color: var(--border-color);"
          >
            <h3 class="text-xl font-extrabold sm:text-2xl" style="color: var(--text-primary);">
              {card.title}
            </h3>

            <!-- Cloud Disadvantage -->
            <div
              class="flex items-start gap-3 rounded-2xl border p-3.5 text-sm font-semibold"
              style="background-color: rgba(168, 32, 32, 0.08); border-color: rgba(168, 32, 32, 0.35); color: var(--text-secondary);"
            >
              <span class="mt-0.5 shrink-0 font-black" aria-hidden="true">✕</span>
              <p>{card.cloud}</p>
            </div>

            <!-- 100% Client-Side Local Advantage -->
            <div
              class="flex items-start gap-3 rounded-2xl border-2 p-4 text-base font-bold"
              style="background-color: var(--surface-subtle); border-color: #31AAA9; color: var(--text-primary);"
            >
              <span
                class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-xs font-black"
                style="background-color: #31AAA9; color: #1A0909;"
                aria-hidden="true"
              >
                ✓
              </span>
              <p>{card.local}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- =================================================================== -->
  <!-- SECTION 3: HIGH-INTENT SEO FAQ ACCORDION                            -->
  <!-- =================================================================== -->
  <section aria-labelledby="faq-heading" class="space-y-10">
    <div class="text-center">
      <span
        class="mb-3 inline-block rounded-full px-4 py-1.5 text-xs font-extrabold uppercase tracking-wider"
        style="background-color: #F8E0A4; color: #6C1A1A; border: 1.5px solid #6C1A1A;"
      >
        {t('faq.sectionBadge')}
      </span>
      <h2 id="faq-heading" class="section-heading mx-auto max-w-3xl">
        {t('faq.title')}
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-lg font-medium" style="color: var(--text-secondary);">
        {t('faq.subtitle')}
      </p>
    </div>

    <div class="mx-auto max-w-4xl space-y-4">
      {
        faqs.map((item, index) => (
          <details
            class="group rounded-2xl border-2 p-5 transition-colors"
            style="background-color: var(--workspace-box-bg); border-color: var(--border-color);"
            open={index === 0}
          >
            <summary
              class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-extrabold sm:text-xl"
              style="color: var(--text-primary);"
            >
              <h3 class="text-lg font-extrabold sm:text-xl">{item.q}</h3>
              <span
                class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border-2 text-base font-black transition-transform duration-200 group-open:rotate-45"
                style="border-color: #31AAA9; color: var(--accent-text-readable);"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <p
              class="mt-3 border-t pt-3 text-base font-medium leading-relaxed"
              style="border-color: var(--border-color); color: var(--text-secondary);"
            >
              {item.a}
            </p>
          </details>
        ))
      }
    </div>
  </section>
</div>

<!-- Footer -->
<footer
  class="mt-12 border-t-2 py-10"
  style="background-color: var(--workspace-box-bg); border-color: var(--border-color);"
>
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-6 px-4 text-center sm:px-6 md:flex-row md:text-left">
    <div class="space-y-2">
      <p class="text-base font-extrabold" style="color: var(--text-primary);">
        {t('footer.tagline')}
      </p>
      <p class="text-sm font-bold" style="color: var(--accent-text-readable);">
        ● {t('footer.privacyBadge')}
      </p>
      <p class="text-xs font-semibold" style="color: var(--text-primary);">
        © {new Date().getFullYear()} {t('footer.copyright')}
      </p>
    </div>

    <div class="flex flex-col items-center gap-2 md:items-end">
      <span class="text-xs font-bold" style="color: var(--text-secondary);">
        {t('footer.supportText')}
      </span>
      <a
        href="https://ko-fi.com/kishara"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t('nav.supportDevAria')}
        class="inline-flex items-center gap-2 rounded-2xl border-2 px-5 py-2.5 text-sm font-extrabold shadow-xs transition-transform hover:scale-105"
        style="background-color: #F8E0A4; color: #6C1A1A; border-color: #6C1A1A;"
      >
        <svg
          class="h-5 w-5"
          style="color: #A82020;"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
        </svg>
        <span>{t('nav.supportDev')}</span>
      </a>
    </div>
  </div>
</footer>
